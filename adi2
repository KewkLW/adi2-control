#!/usr/bin/env python3
"""adi2: control an RME ADI-2 Pro over its USB MIDI port (RME SysEx protocol v1.2).

Protocol: docs/proto/MIDITable_ADI-2_261030.ods (RME, "MIDI-Protocol for RME ADI-2 DAC,
ADI-2 Pro and ADI-2/4 Pro SE/EX"). Stdlib + libasound (ctypes), talks to the ALSA sequencer port.

  adi2 dump [--json]          every setting, decoded
  adi2 get ph12.volume        one setting (scope.param)
  adi2 set ph12.volume -20    set one or more: adi2 set ph12.mute on ph12.dim off
  adi2 status                 lock/clock/plug/rate status word
  adi2 watch                  print changes live (knob turns, remote)
  adi2 list [scope]           all known parameter names and allowed values
  adi2 preset load|save N     device setups 1..9 (save overwrites that slot)
  adi2 raw F0 ... F7          send raw SysEx, print replies
"""
import ctypes, ctypes.util, json, re, select, sys, time

VENDOR = [0x00, 0x20, 0x0D]
DEV_ID = 0x72  # ADI-2 Pro

# ---------------------------------------------------------------- parameter tables
def onoff():
    return ["off", "on"]

