READONLY = {("device", "sample_rate")}

# scope name -> (address, table)
SCOPES = {
    "input": (0, INPUT), "input_eq_l": (1, eq(True)), "input_eq_r": (2, eq(False)),
    "line": (3, output(False)), "line_eq_l": (4, eq(True)), "line_eq_r": (5, eq(False)),
    "ph12": (6, output(True)), "ph12_eq_l": (7, eq(True)), "ph12_eq_r": (8, eq(False)),
    "ph34": (9, output(True)), "ph34_eq_l": (10, eq(True)), "ph34_eq_r": (11, eq(False)),
    "device": (12, DEVICE),
}
ADDR2SCOPE = {a: s for s, (a, _) in SCOPES.items()}

# ---------------------------------------------------------------- encode / decode
def s12(v):
    return v - 4096 if v & 0x800 else v

def decode_container(b1, b2, b3):
    addr = (b1 >> 3) & 0xF
    if addr == 12:
        idx = ((b1 & 7) << 3) | ((b2 >> 4) & 7)
        return addr, idx, ((b2 & 0xF) << 7) | b3, False
    idx = ((b1 & 7) << 2) | ((b2 >> 5) & 3)
    raw12 = ((b2 & 0x1F) << 7) | b3
    return addr, idx, raw12, True

def encode_container(addr, idx, raw):
    if addr == 12:
        return [(addr << 3) | (idx >> 3), ((idx & 7) << 4) | ((raw >> 7) & 0xF), raw & 0x7F]
    return [(addr << 3) | (idx >> 2), ((idx & 3) << 5) | ((raw >> 7) & 0x1F), raw & 0x7F]

def to_human(addr, idx, raw12, chan):
    scope = ADDR2SCOPE.get(addr)
    if scope is None or scope in ("eq_preset_l", "eq_preset_r"):
        return f"addr{addr}", f"p{idx}", raw12
    name, kind = SCOPES[scope][1].get(idx, (f"p{idx}", None))
    if kind == "hz":
        f10 = bool(raw12 & 0x800) if chan else False
        val = (raw12 & 0x7FF) * (10 if f10 else 1)
        return scope, name, val
    v = s12(raw12) if chan else raw12
    if isinstance(kind, list):
        return scope, name, kind[v] if 0 <= v < len(kind) else v
    if isinstance(kind, float):
        return scope, name, round(v * kind, 2)
    return scope, name, v

def from_human(scope, name, text):
    addr, table = SCOPES[scope]
    hit = [(i, k) for i, (n, k) in table.items() if n == name]
    if not hit:
        sys.exit(f"unknown param {scope}.{name}  (try: adi2 list {scope})")
    idx, kind = hit[0]
    if (scope, name) in READONLY:
        sys.exit(f"{scope}.{name} is display only")
    t = str(text).lower()
    if isinstance(kind, list):
        if t in ("on", "true", "yes") and kind == onoff(): v = 1
        elif t in ("off", "false", "no") and kind == onoff(): v = 0
        elif t in [k.lower() for k in kind]: v = [k.lower() for k in kind].index(t)
        elif re.fullmatch(r"-?\d+", t) and 0 <= int(t) < len(kind) and t not in kind: v = int(t)
        else: sys.exit(f"{scope}.{name}: '{text}' not in {kind}")
        raw = v & 0xFFF
    elif kind == "hz":
        f = int(float(t.rstrip("hz").rstrip("k") or 0) * (1000 if t.endswith("k") or t.endswith("khz") else 1))
        raw = (0x800 | round(f / 10)) if f > 2047 else f
    elif isinstance(kind, float):
        v = round(float(t.replace("db", "")) / kind)
        raw = v & 0xFFF
    else:
        raw = int(t, 0) & 0xFFF
    return addr, idx, raw, kind

# ---------------------------------------------------------------- MIDI I/O (ALSA sequencer)
# Talks to the ADI-2 Pro's sequencer port through libasound (ctypes), so it shares the port with
# a DAW instead of needing exclusive use of the raw MIDI device.
DEVICE_NAME = "ADI-2 Pro"
SEQ_EVENT_NONE, SEQ_QUEUE_DIRECT, SEQ_ADDRESS_SUBSCRIBERS, SEQ_ADDRESS_UNKNOWN = 255, 253, 254, 253
SEQ_OPEN_DUPLEX, SEQ_NONBLOCK, SEQ_KERNEL_CLIENT = 3, 1, 2
CAP_READ, CAP_WRITE, CAP_SUBS_READ, CAP_SUBS_WRITE = 1, 2, 0x20, 0x40
PORT_TYPE_MIDI_GENERIC, PORT_TYPE_APPLICATION = 1 << 1, 1 << 20
EAGAIN, EBUSY, ENOSPC = 11, 16, 28

class SeqEvent(ctypes.Structure):  # snd_seq_event_t, 28 bytes (alsa/seq_event.h)
    _fields_ = [("type", ctypes.c_ubyte), ("flags", ctypes.c_ubyte), ("tag", ctypes.c_ubyte),
                ("queue", ctypes.c_ubyte), ("time", ctypes.c_ubyte * 8),
                ("src_client", ctypes.c_ubyte), ("src_port", ctypes.c_ubyte),
                ("dst_client", ctypes.c_ubyte), ("dst_port", ctypes.c_ubyte),
                ("data", ctypes.c_ubyte * 12)]
assert ctypes.sizeof(SeqEvent) == 28

class PollFd(ctypes.Structure):
    _fields_ = [("fd", ctypes.c_int), ("events", ctypes.c_short), ("revents", ctypes.c_short)]

_ERR_HANDLER = ctypes.CFUNCTYPE(None, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p)
_quiet = _ERR_HANDLER(lambda *a: None)  # keep a reference: libasound holds the pointer

def libasound():
    try:
        lib = ctypes.CDLL(ctypes.util.find_library("asound") or "libasound.so.2")
    except OSError:
        sys.exit("libasound (alsa-lib) not found; adi2 needs it for the ALSA sequencer")
    lib.snd_lib_error_set_handler(_quiet)  # no "ALSA lib ..." noise on stderr
    P, I = ctypes.c_void_p, ctypes.c_int
    for name, res, args in [
        ("snd_seq_open", I, [ctypes.POINTER(P), ctypes.c_char_p, I, I]),
        ("snd_seq_set_client_name", I, [P, ctypes.c_char_p]),
        ("snd_seq_create_simple_port", I, [P, ctypes.c_char_p, ctypes.c_uint, ctypes.c_uint]),
        ("snd_seq_connect_from", I, [P, I, I, I]), ("snd_seq_connect_to", I, [P, I, I, I]),
        ("snd_seq_poll_descriptors", I, [P, ctypes.POINTER(PollFd), ctypes.c_uint, ctypes.c_short]),
        ("snd_seq_event_input", I, [P, ctypes.POINTER(ctypes.POINTER(SeqEvent))]),
        ("snd_seq_event_output_direct", I, [P, ctypes.POINTER(SeqEvent)]),
        ("snd_seq_client_info_malloc", I, [ctypes.POINTER(P)]), ("snd_seq_port_info_malloc", I, [ctypes.POINTER(P)]),
        ("snd_seq_client_info_set_client", None, [P, I]), ("snd_seq_client_info_get_client", I, [P]),
        ("snd_seq_client_info_get_name", ctypes.c_char_p, [P]), ("snd_seq_client_info_get_type", I, [P]),
        ("snd_seq_client_info_get_card", I, [P]),
        ("snd_seq_query_next_client", I, [P, P]),
        ("snd_seq_port_info_set_client", None, [P, I]), ("snd_seq_port_info_set_port", None, [P, I]),
        ("snd_seq_port_info_get_port", I, [P]), ("snd_seq_port_info_get_capability", ctypes.c_uint, [P]),
        ("snd_seq_query_next_port", I, [P, P]),
        ("snd_midi_event_new", I, [ctypes.c_size_t, ctypes.POINTER(P)]),
        ("snd_midi_event_no_status", None, [P, I]),
        ("snd_midi_event_encode", ctypes.c_long, [P, ctypes.c_char_p, ctypes.c_long, ctypes.POINTER(SeqEvent)]),
        ("snd_midi_event_decode", ctypes.c_long, [P, ctypes.c_char_p, ctypes.c_long, ctypes.POINTER(SeqEvent)]),
        ("snd_strerror", ctypes.c_char_p, [I]),
    ]:
        f = getattr(lib, name); f.restype, f.argtypes = res, args
    return lib

def find_port(lib, seq):
    """(client, port, card) of the ADI-2 Pro's MIDI port: a kernel (card) client, port 0 = midiC*D0."""
    ci, pi = ctypes.c_void_p(), ctypes.c_void_p()
    lib.snd_seq_client_info_malloc(ctypes.byref(ci)); lib.snd_seq_port_info_malloc(ctypes.byref(pi))
    lib.snd_seq_client_info_set_client(ci, -1)
    want = CAP_READ | CAP_WRITE | CAP_SUBS_READ | CAP_SUBS_WRITE
    while lib.snd_seq_query_next_client(seq, ci) >= 0:
        name = (lib.snd_seq_client_info_get_name(ci) or b"").decode(errors="replace")
        if DEVICE_NAME not in name or lib.snd_seq_client_info_get_type(ci) != SEQ_KERNEL_CLIENT:
            continue
        client = lib.snd_seq_client_info_get_client(ci)
        lib.snd_seq_port_info_set_client(pi, client); lib.snd_seq_port_info_set_port(pi, -1)
        while lib.snd_seq_query_next_port(seq, pi) >= 0:
            if lib.snd_seq_port_info_get_capability(pi) & want == want:
                return client, lib.snd_seq_port_info_get_port(pi), lib.snd_seq_client_info_get_card(ci)
    sys.exit("ADI-2 Pro MIDI port not found (is it plugged in and powered?)")

def raw_holder(card):
    """'<comm> (pid N)' of the process holding the card's raw MIDI port, from /proc/asound, or None."""
    try:
        with open(f"/proc/asound/card{card}/midi0") as f:
            pids = re.findall(r"Owner PID\s*:\s*(\d+)", f.read())
    except OSError:
        return None
    for pid in dict.fromkeys(pids):
        try:
            with open(f"/proc/{pid}/comm") as f:
                return f"{f.read().strip()} (pid {pid})"
        except OSError:
            return f"pid {pid}"
    return None

def raw_held_line(card):
    holder = raw_holder(card) if card >= 0 else None
    who = holder or "another program"
    hw = f" (hw:{card},0,0)" if card >= 0 else ""
    return f"the ADI-2 Pro MIDI port{hw} is held as raw MIDI by {who}; close it or free the port in that program"

class Dev:
    def __init__(self):
        lib = self.lib = libasound()
        err = lambda e: lib.snd_strerror(e).decode(errors="replace")
        self.seq = ctypes.c_void_p()
        e = lib.snd_seq_open(ctypes.byref(self.seq), b"default", SEQ_OPEN_DUPLEX, SEQ_NONBLOCK)
        if e < 0: sys.exit(f"cannot open the ALSA sequencer: {err(e)}")
        lib.snd_seq_set_client_name(self.seq, b"adi2")
        *addr, self.card = find_port(lib, self.seq)
        self.addr = tuple(addr)
        self.port = lib.snd_seq_create_simple_port(self.seq, b"adi2", CAP_READ | CAP_WRITE,
                                                   PORT_TYPE_MIDI_GENERIC | PORT_TYPE_APPLICATION)
        if self.port < 0: sys.exit(f"cannot create a sequencer port: {err(self.port)}")
        for connect in (lib.snd_seq_connect_from, lib.snd_seq_connect_to):
            e = connect(self.seq, self.port, *self.addr)
            if e in (-EAGAIN, -EBUSY): sys.exit(raw_held_line(self.card))  # a raw MIDI open owns the substream
            if e < 0: sys.exit(f"cannot connect to ADI-2 Pro MIDI port {self.addr[0]}:{self.addr[1]}: {err(e)}")
        pfd = PollFd()
        if lib.snd_seq_poll_descriptors(self.seq, ctypes.byref(pfd), 1, select.POLLIN) != 1:
            sys.exit("cannot get the ALSA sequencer poll descriptor")
        self.fd = pfd.fd
        self.enc, self.dec = ctypes.c_void_p(), ctypes.c_void_p()
        lib.snd_midi_event_new(4096, ctypes.byref(self.enc)); lib.snd_midi_event_new(16, ctypes.byref(self.dec))
        lib.snd_midi_event_no_status(self.dec, 1)
        self.dbuf = ctypes.create_string_buffer(65536)
        self.buf = bytearray()

    def write(self, data):
        """send raw MIDI bytes to the device (encoded into sequencer events)."""
        data = bytes(data)
        while data:
            ev = SeqEvent()
            n = self.lib.snd_midi_event_encode(self.enc, data, len(data), ctypes.byref(ev))
            if n <= 0: break
            data = data[n:]
            if ev.type == SEQ_EVENT_NONE: continue  # incomplete message, encoder wants more bytes
            ev.queue = SEQ_QUEUE_DIRECT
            ev.src_port = self.port
            ev.dst_client, ev.dst_port = SEQ_ADDRESS_SUBSCRIBERS, SEQ_ADDRESS_UNKNOWN
            e = self.lib.snd_seq_event_output_direct(self.seq, ctypes.byref(ev))
            if e < 0: sys.exit(f"MIDI send to ADI-2 Pro failed: {self.lib.snd_strerror(e).decode(errors='replace')}")

    def send(self, cmd, payload=()):
        self.write([0xF0, *VENDOR, DEV_ID, cmd, *payload, 0xF7])

    def read(self):
        """drain every pending sequencer event from the device into self.buf as MIDI bytes."""
        evp = ctypes.POINTER(SeqEvent)()
        while True:
            e = self.lib.snd_seq_event_input(self.seq, ctypes.byref(evp))
            if e == -ENOSPC: continue  # input overrun: events were dropped, keep reading
            if e < 0: return  # -EAGAIN: nothing left
            ev = evp.contents
            if (ev.src_client, ev.src_port) != self.addr: continue
            n = self.lib.snd_midi_event_decode(self.dec, self.dbuf, len(self.dbuf), evp)
            if n > 0: self.buf += self.dbuf.raw[:n]

    def messages(self, quiet=1.2, total=8.0, forever=False):
        """yield complete SysEx messages until `quiet` s of silence (or forever)."""
        start = last = time.time()
        while True:
            to = None if forever else max(0, min(quiet - (time.time() - last), total - (time.time() - start)))
            if to == 0:
                return
            r, _, _ = select.select([self.fd], [], [], to)
            if not r:
                if forever: continue
                return
            self.read()
            last = time.time()
            while True:
                s = self.buf.find(0xF0)
                if s < 0: self.buf.clear(); break
                e = self.buf.find(0xF7, s)
                if e < 0: del self.buf[:s]; break
                m = bytes(self.buf[s:e + 1]); del self.buf[:e + 1]
                if list(m[1:5]) == VENDOR + [DEV_ID]:
                    yield m

    def params(self, msg):
        if msg[5] != 0x01: return []
        body = msg[6:-1]
        return [decode_container(*body[i:i + 3]) for i in range(0, len(body) - 2, 3)]

NO_REPLY = "no reply from the device (ADI-2 Pro MIDI port found, but it sent nothing)"

def read_all(dev):
    dev.send(0x03, [0x09])
    state, status = {}, None
    last_param = time.time()
    for m in dev.messages(total=5.0):
        if m[5] == 0x07:
            status = m
            # status arrives ~1/s and would keep the quiet timer alive forever
            if state and time.time() - last_param > 0.4: break
            continue
        last_param = time.time()
        for addr, idx, raw, chan in dev.params(m):
            sc, n, v = to_human(addr, idx, raw, chan)
            state.setdefault(sc, {})[n] = v
    return state, status

def decode_status(m):
    b = list(m[5:-1])  # b[0] = 0x07
    if len(b) < 13: return {"raw": m.hex(" ")}
    io1 = b[2] | b[3] << 7 | b[4] << 14 | b[5] << 21
    io2 = b[6] | b[7] << 7 | b[8] << 14 | b[9] << 21
    rates = ["32k", "44.1k", "48k", "?", "64k", "88.2k", "96k", "?", "128k", "176.4k", "192k"]
    rate = lambda x: rates[x] if x < len(rates) else str(x)
    return {
        "active_output_1/2": b[1] & 3, "line_active": (b[1] >> 4) & 3, "phones34_active": bool(b[1] & 0x40),
        "aes_lock": bool(io1 & 1), "spdif_lock": bool(io1 & 2), "aes_sync": bool(io1 & 4), "spdif_sync": bool(io1 & 8),
        "spdif_source": "optical" if io1 & 16 else "coax", "adat": bool(io1 & 32),
        "clock_source": ["internal", "aes", "spdif", "internal"][(io1 >> 6) & 3],
        "aes_in_rate": rate((io1 >> 8) & 15), "spdif_in_rate": rate((io1 >> 12) & 15),
        "internal_rate_code": (io1 >> 16) & 31,
        "phones1_plugged": bool(io1 >> 21 & 1), "phones2_plugged": bool(io1 >> 27 & 1),
        "phones1_overcurrent": bool(io1 >> 25 & 1), "phones2_overcurrent": bool(io1 >> 26 & 1),
        "high_load": bool(io2 & 3), "dsd_usb": bool(io2 & 4),
        "dc_error_phones1": bool(io2 >> 18 & 1), "dc_error_phones2": bool(io2 >> 19 & 1), "power_fail": bool(io2 >> 24 & 1),
        "device_mode": b[10] & 7, "balanced_mode": bool(b[10] & 8),
        "protocol_rev": b[11] & 15, "8ch_mode": bool(b[11] & 16),
        "dac_mode_rate_code": b[12] & 31 if len(b) > 12 else None,
        "dc_detect_line": bool(b[13] & 8) if len(b) > 13 else None,
        "dc_detect_phones": bool(b[13] & 16) if len(b) > 13 else None,
    }

# ---------------------------------------------------------------- commands
def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return
    cmd, args = argv[0], argv[1:]
    if cmd == "list":
        for sc, (a, t) in SCOPES.items():
            if args and sc != args[0]: continue
            for i, (n, k) in sorted(t.items()):
                desc = k if isinstance(k, list) else {0.5: "0.5 dB steps", 0.1: "0.1 steps (volume dB)", 0.01: "-1.00..1.00", "hz": "Hz"}.get(k, "raw int")
                print(f"{sc}.{n:24} {desc}")
        return
    dev = Dev()
    if cmd == "dump":
        state, status = read_all(dev)
        if not state: sys.exit(NO_REPLY)
        if "--json" in args:
            if status is not None: state["_status"] = decode_status(status)
            print(json.dumps(state, indent=1)); return
        for sc in SCOPES:
            if sc not in state: continue
            print(f"[{sc}]")
            for n, v in state[sc].items(): print(f"  {n:24} {v}")
        for sc in state:
            if sc not in SCOPES: print(f"[{sc}] {state[sc]}")
    elif cmd == "get":
        state, _ = read_all(dev)
        if not state: sys.exit(NO_REPLY)
        for a in args:
            sc, n = a.split(".", 1)
            print(f"{a} = {state.get(sc, {}).get(n, '?')}")
    elif cmd == "set":
        if len(args) % 2: sys.exit("usage: adi2 set scope.param value [scope.param value ...]")
        force = "--force" in args
        args = [a for a in args if a != "--force"]
        payload, wanted = [], []
        state = None
        for key, val in zip(args[::2], args[1::2]):
            sc, n = key.split(".", 1)
            if sc not in SCOPES: sys.exit(f"unknown scope {sc}; scopes: {', '.join(SCOPES)}")
            addr, idx, raw, kind = from_human(sc, n, val)
            if n == "volume" and sc.startswith("ph") and not force:
                state = state or read_all(dev)[0]
                cur = state.get(sc, {}).get("volume")
                new = s12(raw) * 0.1
                if isinstance(cur, (int, float)) and new - cur > 6:
                    sys.exit(f"refusing to raise {sc}.volume {cur} -> {new} dB in one step (>6 dB jump, ears). Use --force.")
            payload += encode_container(addr, idx, raw); wanted.append(key)
        dev.send(0x02, payload)
        time.sleep(0.15)
        state, _ = read_all(dev)
        for key in wanted:
            sc, n = key.split(".", 1)
            print(f"{key} = {state.get(sc, {}).get(n, '?')}")
    elif cmd == "status":
        dev.send(0x03, [0x09])
        for m in dev.messages(quiet=1.5, total=4):
            if m[5] == 0x07:
                print(json.dumps(decode_status(m), indent=1)); return
        sys.exit(NO_REPLY)
    elif cmd == "watch":
        dev.send(0x03, [0x09])
        seen = {}
        for m in dev.messages(forever=True):
            for addr, idx, raw, chan in dev.params(m):
                sc, n, v = to_human(addr, idx, raw, chan)
                if seen.get((sc, n)) != v:
                    if (sc, n) in seen: print(f"{time.strftime('%H:%M:%S')} {sc}.{n} = {v}", flush=True)
                    seen[(sc, n)] = v
    elif cmd == "preset":
        if len(args) != 2 or args[0] not in ("load", "save") or not args[1].isdigit() or not 1 <= int(args[1]) <= 9:
            sys.exit("usage: adi2 preset load|save 1..9")
        n = int(args[1])
        dev.send(0x04, [n if args[0] == "load" else 0x09 + n])
        print(f"{args[0]}ed setup {n}")
    elif cmd == "factory":
        if "--yes" not in args: sys.exit("factory reset wipes device settings: adi2 factory --yes")
        dev.send(0x04, [0x13]); print("factory settings loaded")
    elif cmd == "raw":
        b = bytes(int(x, 16) for x in args)
        dev.write(b)
        for m in dev.messages(): print(m.hex(" ").upper())
    else:
        sys.exit(f"unknown command {cmd}\n{__doc__}")

if __name__ == "__main__":
    main(sys.argv[1:])
